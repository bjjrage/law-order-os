{
  "name": "law-order-junta-juridica-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "build:os-core": "node node_modules/typescript/bin/tsc -p os-core/tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "board:test": "node node_modules/vitest/vitest.mjs run",
    "board:smoke:offline": "node scripts/board.mjs smoke",
    "board:benchmark:offline": "node scripts/board.mjs benchmark",
    "board:show": "node scripts/board.mjs show",
    "board:connectivity": "node scripts/board.mjs connectivity",
    "board:plan": "node scripts/board.mjs plan",
    "board:recover": "node scripts/board.mjs recover",
    "board:live": "node scripts/board.mjs live",
    "board:live:preflight": "node scripts/board.mjs live-preflight",
    "board:live:smoke": "node scripts/board.mjs live-smoke",
    "corpus:verify": "node phase2/tooling/download-official-corpus.mjs",
    "corpus:review": "node phase2/tooling/review-pdfs.mjs",
    "library:research:sync": "node scripts/library-research-sync.mjs",
    "library:corpus:sync": "node scripts/library-corpus-ingest.mjs",
    "os:typecheck": "node node_modules/typescript/bin/tsc -p apps/os.tsconfig.json",
    "os:build:api": "node node_modules/typescript/bin/tsc -p apps/api/tsconfig.build.json",
    "os:build:web": "node scripts/build-web.mjs",
    "os:postgres": "node dist/os-app/infra/local/postgres.js",
    "os:configure": "node dist/os-app/infra/local/configure.js",
    "os:start": "node dist/os-app/apps/api/src/main.js",
    "os:local": "node scripts/local-browser.mjs",
    "os:test:local": "node node_modules/vitest/vitest.mjs run --config local-browser/vitest.config.ts",
    "junta:preparar": "node scripts/junta-setup.mjs preparar",
    "junta:estado": "node scripts/junta-setup.mjs estado",
    "junta:comprobar": "node scripts/junta-check.mjs",
    "os:test": "node node_modules/vitest/vitest.mjs run --config f1-f4/vitest.config.ts",
    "os:seed": "node dist/os-app/infra/local/seed.js",
    "os:worker": "node dist/os-app/apps/api/src/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@hocuspocus/provider": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@hocuspocus/transformer": "4.7.1",
    "@huggingface/tokenizers": "0.2.0",
    "@supabase/supabase-js": "2.117.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "better-auth": "1.7.10",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "ws": "8.22.0",
    "yjs": "13.6.33",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "8.18.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.3"
  }
}
