# Copiar a .env y cargarlo explícitamente con node --env-file=.env; nunca versionar secretos.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
OPENAI_API_KEY=
OPENAI_LUNA_MODEL=gpt-6-luna
OPENAI_SOL_MODEL=gpt-6.1-sol
OPENAI_SOL_REASONING_EFFORT=medium
GEMINI_API_KEY=
GEMINI_AUDITOR_MODEL=gemini-3.8-flash
BOARD_MAX_COST_USD=5
BOARD_TIMEOUT_MS=120000
BOARD_MAX_RETRIES=1
BOARD_MAX_RETRIEVALS=2
# Conservador por defecto. La ventana real debe confirmarse antes de generar.
BOARD_AUDITOR_MAX_INPUT_TOKENS=100000
BOARD_AUDITOR_MAX_OUTPUT_TOKENS=16000
# Requiere tarifas por model ID, origen y fecha; ver RUNBOOK. No se suponen tarifas reales.
BOARD_PRICE_FILE=
