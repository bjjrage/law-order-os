# JUNTA JURIDICA - completar solo en el archivo .env de la raiz.
# Las claves vacias usan la variable del proceso si ya existe.
# No pegar secretos en el chat, en VITE_*, ni en localStorage.
JEV_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# IDs exigidos por los adaptadores actuales. Acceso de cuenta NO verificado.
JEV_MODEL=jev-1.13.0
OPENAI_LUNA_MODEL=gpt-6-luna
OPENAI_SOL_MODEL=gpt-6.1-sol
OPENAI_SOL_REASONING_EFFORT=medium
GEMINI_AUDITOR_MODEL=gemini-3.8-flash

# One live workflow, configured in packages/workspace/src/analysis-levels.ts:
# AGIL = DeepSeek low; MEDIO = DeepSeek high; PROFUNDO = Sol 6.1 xhigh.
# Gabriel stays on Luna. Santiago uses Gemini, with independent Luna xhigh fallback.
# Same controls and shared budget for every level. Human selection travels with each job.
# JEV and OPENAI_SOL_REASONING_EFFORT above remain for historical/offline tooling only.
GABRIEL_REASONING_EFFORT=xhigh
DEEPSEEK_ANALYSIS_MODEL=deepseek-flash

# Preparacion conservadora. Ningun valor de este archivo autoriza gasto.
BOARD_MAX_COST_USD=0.60
BOARD_TIMEOUT_MS=120000
BOARD_MAX_RETRIES=0
BOARD_MAX_RETRIEVALS=0
BOARD_AUDITOR_MAX_INPUT_TOKENS=100000
BOARD_AUDITOR_MAX_OUTPUT_TOKENS=16000
BOARD_PRICE_FILE=phase2/reports/model-connectivity-standard-prices.json
